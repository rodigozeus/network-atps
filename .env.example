# Copie este arquivo para .env e preencha os valores reais
# O arquivo .env NUNCA deve ser commitado

# Banco de dados
# Para desenvolvimento local: túnel SSH → PostgreSQL do damaceno
# ssh -i ~/.ssh/id_ed25519 -p 2222 -L 5432:localhost:5432 -N rodigozeus@localhost
DATABASE_URL=postgresql://usuario:senha@localhost:5432/atps_db

# JWT
JWT_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=7
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# E-mail (SMTP) — usado para redefinição de senha. Se não preenchido, o link
# de redefinição só é logado no console do backend (útil em dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@redeatps.org

# URL pública do frontend — usada para montar o link de redefinição de senha
FRONTEND_URL=http://localhost:5173

# Segredo usado para gerar o hash (HMAC-SHA256) do CPF no cadastro — o CPF em
# si nunca é armazenado, apenas esse hash (para impedir cadastros duplicados).
# Gere um valor aleatório longo e NUNCA o reutilize/exponha.
CPF_HASH_SECRET=troque-por-um-segredo-aleatorio-longo

# Token da API de Dados do Portal da Transparência (https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email)
# usado para confirmar, no cadastro, se o CPF informado pertence a um(a) ATPS
# ativo(a). Requer login gov.br (nível Prata/Ouro) para ser gerado. É a ÚNICA
# forma de verificação automática — se deixado em branco, ou se a API estiver
# fora do ar, TODO cadastro fica pendente de aprovação manual por um admin.
PORTAL_TRANSPARENCIA_TOKEN=

# Backend
BACKEND_PORT=8000

# Frontend (usado pelo Vite)
VITE_API_URL=http://localhost:8000
